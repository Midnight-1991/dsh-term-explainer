{
  "name": "dsh-term-explainer",
  "version": "1.3.0",
  "type": "module",
  "description": "Explain computer terms that appear in DeepSeek Harness assistant answers: 577-entry offline dictionary (curated + CC-BY-4.0/Apache-2.0/MIT sources), per-message entry, searchable dictionary, favorites and exports, no model calls.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "glossary",
    "terminology",
    "computer-science"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Midnight-1991/dsh-term-explainer.git"
  },
  "homepage": "https://github.com/Midnight-1991/dsh-term-explainer#readme",
  "bugs": {
    "url": "https://github.com/Midnight-1991/dsh-term-explainer/issues"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "PROMPT.md",
    "THIRD_PARTY_NOTICES.md",
    "GLOSSARY-SOURCES.md",
    "PROMPT-GLOSSARY-EXPANSION.md",
    "data/external-glossary.json",
    "scripts/smoke.mjs",
    "scripts/sync-external-glossary.mjs",
    "scripts/embed-external-glossary.mjs"
  ],
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "glossary:sync": "node scripts/sync-external-glossary.mjs",
    "glossary:embed": "node scripts/embed-external-glossary.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
